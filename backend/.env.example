ORDS_URL=https://<host>.adb.us-ashburn-1.oraclecloudapps.com/ords/popeyes/view_bsc_diario_rest/
CACHE_TTL_MIN=10
PORT=3001
JWT_SECRET=<genera-un-secreto-largo-aleatorio>
NODE_ENV=development
# ORDS_MODE=mock  -> SOLO DESARROLLO: ignora ORDS_URL y sirve datos sintéticos (ver src/ords/mockData.ts).
#                     Déjalo sin definir (o en cualquier otro valor) para el comportamiento real.

# Autenticación contra ORDS (opcional). Con ORDS_AUTH=basic, cada request a ORDS_URL lleva el
# header `Authorization: Basic <base64(user:password)>`. Sin ORDS_AUTH (o con otro valor), no se
# agrega ningún header de autenticación. No aplica cuando ORDS_MODE=mock.
# ORDS_AUTH=basic
# ORDS_USER=<usuario>
# ORDS_PASSWORD=<password>

# API de Kimi (Moonshot), usada por el chat/asistente (POST /api/chat, ver src/chat/).
# Plataforma internacional (api.moonshot.ai) — no confundir con api.moonshot.cn.
KIMI_API_KEY=<tu-api-key-de-moonshot>
